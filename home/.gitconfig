[user]
    email = code@mamo.aleeas.com
    name = markmacode

[init]
    defaultBranch = main

[core]
    editor = nvim
    excludesfile = ~/.gitignore
    autocrlf = input
    pager = delta

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[pager]
    branch = false

[alias]
    personal = !git config --local --replace-all user.name "markmacode" && \
        git config --local --replace-all user.email "code@mamo.aleeas.com" && \
        git config --local -l

    a = add --all
    # Branch
    b = branch -vv
    ba = branch -vv -a
    br = branch -r
    # Commit
    c = commit
    ca = commit -a
    cm = commit -m
    cam = commit -am
    cd = commit --amend --no-edit
    # Cherry Pick
    cp = cherry-pick
    # Logging
    l = log --graph --abbrev-commit --decorate \
        --format=format:'%C(auto)%h%C(auto)%d %s %C(italic dim white)~ %an'
    # Checking out
    o = checkout
    # Status
    s = status -sb
    sv = status --long
    damn = "!f() { git fetch origin main && git stash && git checkout --no-track  -b \"$1\" origin/main && git stash pop; }; f"
    clean-branches = "!f() { \
        printf \"\\n\\033[1;34m󰃢  Running branch cleanup...\\033[0m\\n\"; \
        \
        git branch --merged=main | grep -v '^\\*' | sed 's/^[[:space:]]*//' | grep -vw main | while read -r br; do \
            if [ -n \"$br\" ]; then \
                if git branch -d \"$br\" >/dev/null 2>&1; then \
                    printf \"   \\033[1;32m  Deleted merged:\\033[0m %s\\n\" \"$br\"; \
                else \
                    printf \"   \\033[1;33m  Skipped merged:\\033[0m %s (currently checked out in a worktree)\\n\" \"$br\"; \
                fi; \
            fi; \
        done; \
        \
        git branch -vv | grep ': gone]' | awk '{if ($1 == \"*\") print $2; else print $1}' | while read -r br; do \
            if [ -n \"$br\" ]; then \
                if git branch -D \"$br\" >/dev/null 2>&1; then \
                    printf \"   \\033[1;32m  Deleted gone:\\033[0m %s\\n\" \"$br\"; \
                else \
                    printf \"   \\033[1;33m  Skipped gone:\\033[0m %s (currently checked out in a worktree)\\n\" \"$br\"; \
                fi; \
            fi; \
        done; \
        printf \"\\n\"; \
    }; f"
    clean-worktrees = "!f() { \
        printf \"\\n\\033[1;34m  Fetching origin/main...\\033[0m\\n\"; \
        git fetch origin main -q; \
        git worktree list --porcelain | grep '^worktree ' | sed 's/^worktree //' | while read -r wt; do \
            if [ -d \"$wt/.git\" ]; then \
                wt_name=\"main\"; \
            else \
                wt_name=$(git -C \"$wt\" branch --show-current); \
                [ -z \"$wt_name\" ] && wt_name=\"(detached)\"; \
            fi; \
            printf \"\\n\\033[1;36m  %s @ %s...\\033[0m\\n\" \"$wt_name\" \"$wt\"; \
            ( \
                cd \"$wt\" || exit; \
                git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null); \
                if [ -d \"$git_dir/rebase-merge\" ] || [ -d \"$git_dir/rebase-apply\" ] || [ -f \"$git_dir/MERGE_HEAD\" ] || [ -f \"$git_dir/CHERRY_PICK_HEAD\" ] || [ -f \"$git_dir/REVERT_HEAD\" ] || [ -f \"$git_dir/BISECT_START\" ]; then \
                    printf \"   \\033[1;33m  Skipped:\\033[0m Git operation in progress (rebase/merge/cherry-pick).\\n\"; \
                elif [ -n \"$(git status --porcelain)\" ]; then \
                    printf \"   \\033[1;33m  Skipped:\\033[0m Uncommitted changes.\\n\"; \
                elif [ \"$wt_name\" = \"main\" ]; then \
                    printf \"   \\033[1;32m  Main worktree:\\033[0m Fast-forwarding to origin/main...\\n\"; \
                    [ \"$(git branch --show-current)\" != \"main\" ] && git checkout main -q 2>/dev/null; \
                    git merge --ff-only origin/main -q; \
                elif ! git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then \
                    printf \"   \\033[1;33m  Skipped:\\033[0m Branch has unmerged commits.\\n\"; \
                else \
                    printf \"   \\033[1;32m  Updated:\\033[0m Checked out detached origin/main.\\n\"; \
                    git checkout --detach origin/main -q 2>/dev/null; \
                fi \
            ); \
        done; \
        git clean-branches; \
    }; f"

[include]
    path = ~/.config/work/.gitconfig

[include]
    path = ~/.gitconfig.inject

[color]
    status = always

[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
[merge]
    conflictStyle = zdiff3
